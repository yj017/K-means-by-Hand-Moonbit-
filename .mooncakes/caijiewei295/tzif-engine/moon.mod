name = "caijiewei295/tzif-engine"

version = "0.1.0"

readme = "README.md"

license = "Apache-2.0"

keywords = [ "timezone", "tzif", "iana", "dst", "time", "wasm" ]

description = "Pure MoonBit IANA TZif v2/v3 parser and timezone conversion engine. UTC ↔ local time with full DST handling, POSIX TZ fallback, and no libc timezone API dependency."

import {
  "moonbitlang/x@0.4.46",
}
